# ───────── 数据库 ─────────
# psycopg 单驱动：SQLAlchemy 与 LangGraph 检查点共用。
DATABASE_URL=postgresql+psycopg://fin:fin@localhost:5432/finresearch

# ───────── LLM（OpenAI 兼容；前端 providers.ts 里的 baseUrl 都可填）─────────
# 留空则视为未配置：实时端点（quote/kline/book/indicators）照常工作，
# /api/research 与 /api/chart/analyze 会优雅降级（返回提示而非报错）。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 便宜/快速模型档。用在两处窄任务上：图表速读，以及研究 agent 的主循环
# （那个循环只是"确认标的 → 取数 → 出报告"的固定三步，用不上强模型；
#  而各段正文撰写始终用 LLM_MODEL 的强档，报告质量不受影响）。
# 对话 agent 的主循环不用这一档——那里的规划是开放的，必须强模型。
# 留空则回落 LLM_MODEL，不会因为没配就跑不起来。
CHART_ANALYZE_MODEL=

# ───────── 可选付费数据源（留接口位，不强制）─────────
TUSHARE_TOKEN=
SERPER_API_KEY=

# ───────── 服务 ─────────
HOST=0.0.0.0
PORT=8000
