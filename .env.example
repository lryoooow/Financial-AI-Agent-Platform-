# Web / Docker 监听。服务默认只开放到本机。
FIN_BIND_ADDRESS=127.0.0.1
FIN_PORT=9527
FIN_HOST=127.0.0.1
# 使用局域网或公网访问时，配置高强度口令，并通过 HTTPS 反向代理。
FIN_ACCESS_TOKEN=
# 可选的固定加密密钥。留空时在持久数据目录自动生成。
FIN_SECRET_KEY=
# 可选的逗号分隔主机名和前端源。
FIN_TRUSTED_HOSTS=
FIN_CORS_ORIGINS=
# 可选的 PostgreSQL 连接字符串。数据库需已安装 vector 扩展。
FIN_PGVECTOR_URL=
# 原生启动时可指定数据目录；容器内固定使用 /data。
FINRESEARCH_DATA_DIR=
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
